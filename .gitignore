# yadc project root gitignore
# See yadc/webui/.gitignore for frontend-specific rules.

# Project-local content directories (only examples are tracked)
configs/*
!configs/example*
templates/*
!templates/example*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/

# Tool caches
.pytest_cache/
.ruff_cache/

# Desktop .exe build outputs — see docs/desktop-exe.md. ``dist/``
# contains the PyInstaller artifacts, ``build/`` contains venvs and
# the PyInstaller work tree. Both are recreated by
# scripts/build_windows_exe.{ps1,sh}.
dist/
build/

# Secrets / virtual envs
.env
.envrc
.venv
