# yadc project root gitignore
# See yadc/webui/.gitignore for frontend-specific rules.

# Project-local content directories (only examples are tracked)
configs/*
!configs/example*
templates/*
!templates/example*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/

# Tool caches
.pytest_cache/
.ruff_cache/

# Secrets / virtual envs
.env
.envrc
.venv
